\f0\fs24 \cf0 """\
Brain Tumor Segmentation using SAM 2\
=====================================\
pip install git+https://github.com/facebookresearch/sam2.git transformers gradio torch torchvision pillow numpy opencv-python matplotlib\
\
Run: python brain_tumor_sam2.py\
"""\
\
import gradio as gr\
import torch\
import numpy as np\
import cv2\
import matplotlib.pyplot as plt\
import matplotlib.patches as mpatches\
from PIL import Image\
from transformers import Sam2Processor, Sam2Model\
import warnings\
warnings.filterwarnings("ignore")\
\
# \uc0\u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \
#  MODEL LOADING\
# \uc0\u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \
DEVICE = "cuda" if torch.cuda.is_available() else "cpu"\
print(f"[INFO] Using device: \{DEVICE\}")\
\
print("[INFO] Loading SAM 2 Large...")\
processor = Sam2Processor.from_pretrained("facebook/sam2-hiera-large")\
model     = Sam2Model.from_pretrained("facebook/sam2-hiera-large").to(DEVICE)\
model.eval()\
print("[INFO] Model ready.")\
\
\
# \uc0\u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \
#  AUTO PROMPT GENERATION\
#  Finds the brightest anomalous region in the\
#  MRI scan (tumors appear hyper-intense on T1/T2)\
# \uc0\u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \
def generate_auto_prompts(image_np: np.ndarray):\
    """\
    Automatically detect suspicious bright regions in an MRI and\
    return bounding boxes and center point prompts for SAM 2.\
    Works on grayscale or RGB MRI images.\
    """\
    # Convert to grayscale\
    if image_np.ndim == 3:\
        gray = cv2.cvtColor(image_np, cv2.COLOR_RGB2GRAY)\
    else:\
        gray = image_np.copy()\
\
    # Enhance contrast\
    clahe = cv2.createCLAHE(clipLimit=3.0, tileGridSize=(8, 8))\
    enhanced = clahe.apply(gray)\
\
    # Threshold top 10% intensity pixels (tumor regions are hyper-intense)\
    threshold = np.percentile(enhanced, 90)\
    binary = (enhanced > threshold).astype(np.uint8) * 255\
\
    # Morphological cleaning\
    kernel = cv2.getStructuringElement(cv2.MORPH_ELLIPSE, (7, 7))\
    binary = cv2.morphologyEx(binary, cv2.MORPH_OPEN, kernel)\
    binary = cv2.morphologyEx(binary, cv2.MORPH_CLOSE, kernel)\
\
    # Remove skull/border artifacts (ignore 10% border)\
    h, w = binary.shape\
    margin_h, margin_w = int(h * 0.10), int(w * 0.10)\
    mask_border = np.zeros_like(binary)\
    mask_border[margin_h:h-margin_h, margin_w:w-margin_w] = 1\
    binary = binary * mask_border\
\
    # Find contours\
    contours, _ = cv2.findContours(binary, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)\
\
    if not contours:\
        # Fallback: center of image\
        cx, cy = w // 2, h // 2\
        box_size = min(w, h) // 3\
        return (\
            [[[cx, cy]]],\
            [[[1]]],\
            [[cx - box_size, cy - box_size, cx + box_size, cy + box_size]]\
        )\
\
    # Sort by area, take top 2 largest\
    contours = sorted(contours, key=cv2.contourArea, reverse=True)[:2]\
\
    points, labels, boxes = [], [], []\
    for cnt in contours:\
        area = cv2.contourArea(cnt)\
        if area < 100:\
            continue\
        x, y, bw, bh = cv2.boundingRect(cnt)\
        # Center point of bounding box\
        cx, cy = x + bw // 2, y + bh // 2\
        # Slight padding on bounding box\
        pad = 10\
        x1, y1 = max(0, x - pad), max(0, y - pad)\
        x2, y2 = min(w, x + bw + pad), min(h, y + bh + pad)\
        points.append([[cx, cy]])\
        labels.append([1])\
        boxes.append([x1, y1, x2, y2])\
\
    if not points:\
        cx, cy = w // 2, h // 2\
        box_size = min(w, h) // 3\
        return (\
            [[[cx, cy]]],\
            [[[1]]],\
            [[cx - box_size, cy - box_size, cx + box_size, cy + box_size]]\
        )\
\
    return [points], [labels], boxes\
\
\
# \uc0\u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \
#  SEGMENTATION ENGINE\
# \uc0\u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \
def run_segmentation(image_pil: Image.Image):\
    image_np = np.array(image_pil.convert("RGB"))\
    h, w = image_np.shape[:2]\
\
    # Generate automatic prompts\
    input_points, input_labels, boxes = generate_auto_prompts(image_np)\
\
    # Prepare inputs for SAM 2\
    inputs = processor(\
        images=image_pil.convert("RGB"),\
        input_points=input_points,\
        input_labels=input_labels,\
        return_tensors="pt"\
    ).to(DEVICE)\
\
    with torch.no_grad():\
        outputs = model(**inputs)\
\
    # Post-process masks\
    masks = processor.post_process_masks(\
        outputs.pred_masks.cpu(),\
        inputs["original_sizes"]\
    )[0]  # shape: (num_objects, num_masks, H, W)\
\
    # Pick highest IoU mask per object\
    iou_scores = outputs.iou_scores.cpu()  # (1, num_objects, num_masks)\
    best_masks = []\
    for obj_idx in range(masks.shape[0]):\
        best_idx = torch.argmax(iou_scores[0, obj_idx]).item()\
        best_masks.append(masks[obj_idx, best_idx].numpy())\
\
    return best_masks, boxes, image_np\
\
\
# \uc0\u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \
#  VISUALIZATION\
# \uc0\u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \
COLORS = [\
    (255, 80,  80),   # red-ish\
    (80,  200, 255),  # cyan-ish\
    (80,  255, 150),  # green-ish\
    (255, 180, 50),   # amber\
]\
\
def overlay_masks(image_np, masks, boxes, alpha=0.45):\
    overlay = image_np.copy().astype(np.float32)\
    result  = image_np.copy().astype(np.float32)\
\
    for i, mask in enumerate(masks):\
        color = np.array(COLORS[i % len(COLORS)], dtype=np.float32)\
        mask_bool = mask.astype(bool)\
        overlay[mask_bool] = color\
\
    blended = cv2.addWeighted(result, 1 - alpha, overlay, alpha, 0)\
\
    # Draw bounding boxes\
    for i, box in enumerate(boxes):\
        color_bgr = tuple(int(c) for c in reversed(COLORS[i % len(COLORS)]))\
        x1, y1, x2, y2 = [int(v) for v in box]\
        cv2.rectangle(blended, (x1, y1), (x2, y2), color_bgr, 2)\
        label = f"Region \{i+1\}"\
        cv2.putText(blended, label, (x1, max(0, y1 - 8)),\
                    cv2.FONT_HERSHEY_SIMPLEX, 0.55, color_bgr, 2)\
\
    # Mask contours for crisp edges\
    for i, mask in enumerate(masks):\
        color_bgr = tuple(int(c) for c in reversed(COLORS[i % len(COLORS)]))\
        mask_u8 = (mask * 255).astype(np.uint8)\
        contours, _ = cv2.findContours(mask_u8, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)\
        cv2.drawContours(blended, contours, -1, color_bgr, 2)\
\
    return blended.astype(np.uint8)\
\
\
def compute_stats(masks, image_np):\
    h, w = image_np.shape[:2]\
    total_pixels = h * w\
    stats = []\
    for i, mask in enumerate(masks):\
        area_px = int(mask.sum())\
        area_pct = round(area_px / total_pixels * 100, 2)\
        stats.append(f"**Region \{i+1\}:** \{area_px:,\} px  (\{area_pct\}% of image)")\
    return stats\
\
\
# \uc0\u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \
#  MAIN INFERENCE FUNCTION\
# \uc0\u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \
def segment_brain_tumor(image):\
    if image is None:\
        return None, "\uc0\u9888 \u65039  Please upload an MRI scan."\
\
    try:\
        image_pil = Image.fromarray(image) if isinstance(image, np.ndarray) else image\
        masks, boxes, image_np = run_segmentation(image_pil)\
\
        if not masks:\
            return image, "\uc0\u9989  No significant anomalous regions detected."\
\
        result_np = overlay_masks(image_np, masks, boxes)\
        stats = compute_stats(masks, image_np)\
\
        # Build report\
        n = len(masks)\
        report_lines = [\
            f"### \uc0\u55358 \u56800  Segmentation Complete",\
            f"**Detected Regions:** \{n\}",\
            "",\
            "**Region Analysis:**",\
        ] + stats + [\
            "",\
            "---",\
            "**\uc0\u9877 \u65039  Clinical Note:** This output is AI-generated for research/educational purposes only. "\
            "All findings must be reviewed by a qualified radiologist before any clinical decision.",\
        ]\
        report = "\\n".join(report_lines)\
\
        return result_np, report\
\
    except Exception as e:\
        return image, f"\uc0\u10060  Error during segmentation: \{str(e)\}"\
\
\
# \uc0\u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \
