    background: var(--ink) !important;\
    border: none !important;\
    border-radius: 8px !important;\
    font-family: var(--font-sans) !important;\
    font-size: 0.92rem !important;\
    font-weight: 600 !important;\
    color: var(--white) !important;\
    padding: 13px 28px !important;\
    letter-spacing: 0.01em;\
    cursor: pointer;\
    transition: background 0.15s, transform 0.1s, box-shadow 0.15s;\
    box-shadow: var(--shadow-sm);\
    width: 100%;\
\}\
button.primary:hover \{\
    background: #1a2030 !important;\
    box-shadow: var(--shadow-md);\
    transform: translateY(-1px);\
\}\
button.secondary, .gr-button-secondary \{\
    background: var(--white) !important;\
    border: 1px solid var(--border-dark) !important;\
    border-radius: 8px !important;\
    font-family: var(--font-sans) !important;\
    font-size: 0.88rem !important;\
    font-weight: 500 !important;\
    color: var(--ink-3) !important;\
    transition: background 0.15s;\
\}\
button.secondary:hover \{\
    background: var(--surface) !important;\
    color: var(--ink) !important;\
\}\
\
/* \uc0\u9472 \u9472  IMAGE AREAS \u9472 \u9472  */\
.gr-image, .image-frame \{\
    border-radius: 8px !important;\
    border: 1px solid var(--border) !important;\
    background: var(--surface) !important;\
\}\
\
/* \uc0\u9472 \u9472  TABS \u9472 \u9472  */\
.tab-nav \{\
    border-bottom: 1px solid var(--border) !important;\
    background: transparent !important;\
\}\
.tab-nav button \{\
    font-family: var(--font-sans) !important;\
    font-size: 0.82rem !important;\
    font-weight: 600 !important;\
    color: var(--ink-4) !important;\
    border: none !important;\
    border-bottom: 2px solid transparent !important;\
    background: transparent !important;\
    padding: 12px 18px !important;\
    text-transform: uppercase;\
    letter-spacing: 0.06em;\
    transition: color 0.15s, border-color 0.15s;\
\}\
.tab-nav button.selected \{\
    color: var(--ink) !important;\
    border-bottom-color: var(--ink) !important;\
\}\
.tab-nav button:hover:not(.selected) \{\
    color: var(--ink-2) !important;\
\}\
\
/* \uc0\u9472 \u9472  LABELS \u9472 \u9472  */\
label span, .gr-form label span \{\
    font-family: var(--font-sans) !important;\
    font-size: 0.78rem !important;\
    font-weight: 600 !important;\
    color: var(--ink-3) !important;\
    text-transform: uppercase;\
    letter-spacing: 0.06em;\
\}\
\
/* \uc0\u9472 \u9472  MARKDOWN OUTPUT \u9472 \u9472  */\
.gr-markdown \{\
    font-family: var(--font-sans) !important;\
    font-size: 0.92rem !important;\
    line-height: 1.75 !important;\
    color: var(--ink-2) !important;\
\}\
.gr-markdown h3 \{\
    font-family: var(--font-sans) !important;\
    font-size: 0.82rem !important;\
    font-weight: 700 !important;\
    color: var(--ink) !important;\
    text-transform: uppercase;\
    letter-spacing: 0.07em;\
    margin: 18px 0 10px !important;\
    padding-bottom: 8px;\
    border-bottom: 1px solid var(--border);\
\}\
.gr-markdown strong \{ color: var(--ink); font-weight: 600; \}\
.gr-markdown hr \{ border-color: var(--border) !important; margin: 16px 0; \}\
.gr-markdown blockquote \{\
    border-left: 3px solid var(--blue);\
    padding-left: 12px;\
    color: var(--ink-3);\
    font-style: italic;\
\}\
.gr-markdown ul li::marker \{ color: var(--blue); \}\
\
/* \uc0\u9472 \u9472  WARNING \u9472 \u9472  */\
.warning-card \{\
    background: var(--red-light);\
    border: 1px solid #f5c0bc;\
    border-radius: 8px;\
    padding: 13px 16px;\
    display: flex;\
    gap: 10px;\
    align-items: flex-start;\
    margin-top: 16px;\
\}\
.warning-icon \{ font-size: 15px; flex-shrink: 0; margin-top: 1px; \}\
.warning-text \{\
    font-size: 0.8rem;\
    color: var(--red);\
    line-height: 1.55;\
    font-weight: 500;\
\}\
\
/* \uc0\u9472 \u9472  PIPELINE PILLS \u9472 \u9472  */\
.pipeline \{\
    display: flex;\
    flex-wrap: wrap;\
    gap: 8px;\
    margin-top: 10px;\
\}\
.pill \{\
    display: flex;\
    align-items: center;\
    gap: 5px;\
    padding: 5px 12px;\
    background: var(--surface);\
    border: 1px solid var(--border);\
    border-radius: 100px;\
    font-size: 0.75rem;\
    font-weight: 600;\
    color: var(--ink-2);\
    font-family: var(--font-mono) !important;\
\}\
.pill-arrow \{\
    color: var(--ink-4);\
    font-size: 0.7rem;\
    margin: 0 -2px;\
\}\
\
/* \uc0\u9472 \u9472  FOOTER \u9472 \u9472  */\
.footer \{\
    border-top: 1px solid var(--border);\
    padding: 18px 40px;\
    display: flex;\
    align-items: center;\
    justify-content: space-between;\
    background: var(--white);\
    margin-top: 24px;\
\}\
.footer-left \{\
    font-size: 0.78rem;\
    color: var(--ink-4);\
    font-family: var(--font-mono) !important;\
\}\
.footer-right \{\
    font-size: 0.78rem;\
    color: var(--ink-4);\
\}\
"""\
